# ==============================================================================
# Foodie Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Update the values below to match your server environment.
# 3. Never commit `.env` into version control.
# ==============================================================================
#
# DATABASE CONFIGURATION PROFILES:
# ------------------------------------------------------------------------------
# Profile A: LOCAL DATABASE (MySQL on this local machine)
#   DB_ENGINE=django.db.backends.mysql  (or simply 'mysql')
#   DB_NAME=foodie_db
#   DB_USER=root                        (or foodie_user)
#   DB_PASSWORD=your_local_password
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#
# Profile B: CENTRALIZED DATABASE (Connect to MySQL running on the central server)
#   DB_ENGINE=django.db.backends.mysql  (or simply 'mysql')
#   DB_NAME=foodie_db
#   DB_USER=foodie_user
#   DB_PASSWORD=your_central_password
#   DB_HOST=192.168.150.171             (or your central server's IP)
#   DB_PORT=3306
#
# Profile C: PORTABLE TESTING (SQLite without installing MySQL)
#   DB_ENGINE=sqlite
#   DB_NAME=db.sqlite3
# ==============================================================================

# Core Django Settings
DEBUG=True

# Unique secret key for production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production

# Allowed Hosts (comma-separated list of IPs or domains)
# When running on central server, include server IP (e.g. 192.168.150.171)
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.150.171,*

# Cross-Origin Resource Sharing (CORS)
# Set CORS_ALLOW_ALL_ORIGINS=True to allow LAN clients / mobile devices
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.150.171:5173

# CSRF Trusted Origins (comma-separated, include scheme http:// or https://)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.150.171:5173

# Database Configuration (MySQL 8 is the primary engine)
DB_ENGINE=django.db.backends.mysql
DB_NAME=foodie_db
DB_USER=your_existing_mysql_user
DB_PASSWORD=your_existing_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_foodie_db

# Redis Configuration (Optional for single-process, Recommended for production)
# Example: REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# SSL / HTTPS Settings (Only active when DEBUG=False)
SECURE_SSL_REDIRECT=False

# Admin Recovery & First Setup Secret
DB_SETUP_SECRET=

# Customer OTP Authentication
# Choose 'green_api' for WhatsApp group delivery or 'console' for local terminal logging
OTP_PROVIDER=green_api
OTP_TTL_SECONDS=300
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# Green API WhatsApp OTP Integration (Required when OTP_PROVIDER=green_api)
# Note: OTPs are dispatched strictly to the configured staff/management WhatsApp group ID.
GREEN_API_BASE_URL=https://7107.api.greenapi.com
GREEN_API_INSTANCE_ID=710722790327
GREEN_API_TOKEN=0796d6793c2c424eb73df1153deaf2bcb643b68a3c244ab98e
GREEN_API_GROUP_ID=120363433000068382@g.us

# Foodie OTP Policy
FOODIE_OTP_EXPIRY_MINUTES=5
FOODIE_OTP_MAX_ATTEMPTS=5
FOODIE_OTP_RESEND_COOLDOWN_SECONDS=60
FOODIE_OTP_MAX_RESENDS=3

RAZORPAY_KEY_ID=rzp_test_U1ZUEcFryx95Yw
RAZORPAY_KEY_SECRET=qc86MacCCIeszH5Y10t6D7TG
RAZORPAY_WEBHOOK_SECRET=


# Customer Frontend Base URL (used in generated QR codes)
# e.g. http://192.168.150.171:5173 or http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Green API (SKAND WhatsApp Group Gateway)
GREEN_API_BASE_URL=https://7107.api.greenapi.com
GREEN_API_INSTANCE_ID=710722803735
GREEN_API_TOKEN=e94dd35b96e3481282bfe5c68c3011a352fd180920fa44829f
GREEN_API_GROUP_ID=120363433000068382@g.us
 
# OTP Policy Configuration
OTP_PROVIDER=green_api
FOODIE_OTP_EXPIRY_MINUTES=5
FOODIE_OTP_MAX_ATTEMPTS=5
FOODIE_OTP_RESEND_COOLDOWN_SECONDS=60
FOODIE_OTP_MAX_RESENDS=3