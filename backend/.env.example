# Copy to .env and fill in. Never commit .env.
# Local development keeps DEBUG=True. A release sets DEBUG=False and a long
# random SECRET_KEY. With DEBUG off, HTTPS redirect, secure cookies, and HSTS
# turn on. SECURE_SSL_REDIRECT defaults to true then; set it to False only for
# a local process that is not behind TLS.
DEBUG=True
SECRET_KEY=generate-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=foodie_db
DB_USER=root
DB_PASSWORD=Admin@123
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_foodie_db

OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FRONTEND_BASE_URL=http://localhost:5173
