# ==============================================================================
# Foodie Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows)
# 2. Update the values below to match your server environment.
# 3. Never commit `.env` into version control.
# ==============================================================================

# Core Django Settings
# Set DEBUG=False for production deployments.
DEBUG=True

# Unique random key for production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-long-random-secret-key-for-production

# Allowed Hosts (comma-separated list of IPs or domains)
# Example for centralized server: ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.100,yourdomain.com
# Can also be set as DJANGO_ALLOWED_HOSTS
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Cross-Origin Resource Sharing (CORS)
# Set CORS_ALLOW_ALL_ORIGINS=True to allow any client (convenient for local network/tablets)
# Or specify allowed frontend origins comma-separated:
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF Trusted Origins (comma-separated, include scheme http:// or https://)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (MySQL 8 is the primary engine)
# Set DB_ENGINE=django.db.backends.sqlite3 for quick portable testing without MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=foodie_db
DB_USER=foodie_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_foodie_db

# Redis Configuration (Optional for single-process, Recommended for production)
# When set, Channels WebSockets and DRF Throttling use Redis across multiple workers.
# Example: REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# SSL / HTTPS Settings (Only active when DEBUG=False)
# Keep SECURE_SSL_REDIRECT=False when running behind an HTTP LAN IP or when Nginx handles TLS.
SECURE_SSL_REDIRECT=False

# Admin Recovery & First Setup Secret
# When empty, /db First Admin setup is available only while no administrator exists.
DB_SETUP_SECRET=

# Customer OTP Authentication
# Options: "console" (prints to backend terminal, dev only) or "sms" (requires provider API)
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# Payment Gateway (Razorpay)
# Backend-only credentials for order verification and webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Customer Frontend Base URL (used in generated QR codes)
# e.g. http://192.168.1.100:5173 or https://foodie.yourdomain.com
FRONTEND_BASE_URL=http://localhost:5173
