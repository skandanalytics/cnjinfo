# ==============================================================================
# Foodie Backend — Mode A: Centralized Configuration
# ==============================================================================

FOODIE_MODE=centralized
DEBUG=True
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production

# Centralized Server IP & Allowed Hosts
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.150.171,*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.150.171:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.150.171:5173

# Centralized MySQL Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=foodie_db
DB_USER=foodie_user
DB_PASSWORD=your_central_password
DB_HOST=192.168.150.171
DB_PORT=3306
DB_TEST_NAME=test_foodie_db

# OTP & Authentication
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# Public Frontend URL
FRONTEND_BASE_URL=http://192.168.150.171:5173

