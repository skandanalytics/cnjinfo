# ==============================================================================
# Foodie Restaurant Management — Nginx Configuration Example
# Place in /etc/nginx/sites-available/foodie and symlink to sites-enabled
# ==============================================================================

upstream foodie_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name 192.168.1.100 foodie.local yourdomain.com; # Replace with your server IP or domain

    client_max_body_size 20M;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # 1. Frontend Static Application (built dist/ files)
    root /var/www/foodie/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Django REST Framework APIs
    location /api/ {
        proxy_pass http://foodie_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # 3. Real-time WebSockets (/ws/)
    location /ws/ {
        proxy_pass http://foodie_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 4. Django Admin & DB Portal
    location ~ ^/(admin|db)/ {
        proxy_pass http://foodie_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 5. Media Uploads (dish photos, QR codes)
    location /media/ {
        alias /var/www/foodie/backend/media/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # 6. Django Static Assets
    location /static/ {
        alias /var/www/foodie/backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
