[Unit]
Description=Foodie Django ASGI Daemon (Daphne)
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/foodie/backend
EnvironmentFile=/var/www/foodie/backend/.env
ExecStart=/var/www/foodie/backend/.venv/bin/daphne \
    -b 0.0.0.0 \
    -p 8000 \
    config.asgi:application

Restart=always
RestartSec=3
KillSignal=SIGQUIT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=foodie-backend

[Install]
WantedBy=multi-user.target
