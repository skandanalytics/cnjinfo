# ==============================================================================
# Foodie Frontend Environment Configuration
# ==============================================================================
#
# You have two ways to configure the backend server connection:
#
# METHOD 1: Set VITE_API_BASE_URL below (recommended for different environments)
#   - For centralized server: VITE_API_BASE_URL=http://192.168.1.100:8000
#   - For production domain:  VITE_API_BASE_URL=https://api.yourdomain.com
#   - For local development:  VITE_API_BASE_URL= (leave empty to use Vite proxy /api)
#
# METHOD 2: Edit `DEFAULT_SERVER_URL` in `src/config/apiConfig.js`
#
# Note: WebSocket URL (VITE_WS_BASE_URL) is automatically derived from VITE_API_BASE_URL
# (http:// -> ws:// and https:// -> wss://). Set it manually only if your WebSocket
# server is hosted at a custom path or separate host.
# ==============================================================================

# Backend API server URL (e.g. http://192.168.1.100:8000 or http://your-server-ip:8000)
VITE_API_BASE_URL=

# Optional: Explicit WebSocket URL (e.g. ws://192.168.1.100:8000/ws)
# If omitted, it is automatically derived from VITE_API_BASE_URL
VITE_WS_BASE_URL=

# Optional: Vite dev proxy target (used by vite.config.js when running `npm run dev`)
VITE_API_TARGET=http://127.0.0.1:8000

# Application metadata
VITE_APP_NAME=Foodie
VITE_ENVIRONMENT=production
