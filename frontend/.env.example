# ==============================================================================
# Foodie Frontend Environment Configuration
# ==============================================================================
#
# SWITCHING DEPLOYMENT CONFIGURATIONS:
# ------------------------------------------------------------------------------
# 1. LOCAL DEPLOYMENT (Frontend + Django running on the same local computer):
#    VITE_API_BASE_URL=http://localhost:8000
#    VITE_FRONTEND_BASE_URL=http://localhost:5173
#
# 2. CENTRALIZED DEPLOYMENT (Frontend connects to central server over LAN/Network):
#    VITE_API_BASE_URL=http://192.168.150.171:8000
#    VITE_FRONTEND_BASE_URL=http://192.168.150.171:5173
#
# Note:
# - VITE_API_BASE_URL points to the Django backend (port 8000).
# - VITE_FRONTEND_BASE_URL points to the Vite frontend (port 5173), used for QR codes.
# - WebSocket URL (VITE_WS_BASE_URL) is automatically derived from VITE_API_BASE_URL
#   (http:// -> ws:// and https:// -> wss://).
# ==============================================================================

# Backend API server URL (Django REST API port 8000)
VITE_API_BASE_URL=http://localhost:8000

# Customer-facing Frontend URL (used for table QR codes)
VITE_FRONTEND_BASE_URL=http://localhost:5173

# Optional: Explicit WebSocket URL (e.g. ws://192.168.150.171:8000/ws)
# If omitted, it is automatically derived from VITE_API_BASE_URL
VITE_WS_BASE_URL=

# Vite dev proxy target (used by vite.config.js when running `npm run dev`)
VITE_API_TARGET=http://127.0.0.1:8000

# Application metadata
VITE_APP_NAME=Foodie
VITE_ENVIRONMENT=development
