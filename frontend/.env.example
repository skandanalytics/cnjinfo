# ==============================================================================
# Foodie Frontend Environment Configuration
# ==============================================================================
#
# DEPLOYMENT MODES:
# ------------------------------------------------------------------------------
# 1. LAN / DYNAMIC MODE (DEFAULT - Works across any Wi-Fi network automatically):
#    Frontend automatically detects the current browser address.
#    - If opened via http://localhost:5173 -> Backend connects to http://localhost:8000
#    - If opened via http://192.168.68.104:5173 -> Backend connects to http://192.168.68.104:8000
#    - Mobile phones scanning QR codes connect directly without editing any code.
#
#    VITE_API_MODE=lan
#    VITE_BACKEND_PORT=8000
#
# 2. CENTRALIZED REMOTE SERVER (Frontend on multiple PCs connects to a single dedicated server):
#    VITE_API_MODE=centralized
#    VITE_API_BASE_URL=http://192.168.150.171:8000
#    VITE_FRONTEND_BASE_URL=http://192.168.150.171:5173
#
# 3. LOCALHOST ONLY:
#    VITE_API_MODE=local
#    VITE_BACKEND_PORT=8000
# ==============================================================================

# Active mode ('lan', 'centralized', or 'local')
VITE_API_MODE=lan
VITE_BACKEND_PORT=8000

# Vite proxy target for `npm run dev`
VITE_API_TARGET=http://127.0.0.1:8000

# Metadata
VITE_APP_NAME=Foodie
VITE_ENVIRONMENT=development

# Razorpay Standard Checkout
VITE_RAZORPAY_KEY_ID=


