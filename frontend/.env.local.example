# ==============================================================================
# Foodie Frontend — Mode B: Local Configuration
# ==============================================================================
# In Local mode, the frontend communicates with the local development Django server.
# When opened in a browser from another device on the same LAN (or mobile phone),
# it dynamically targets port 8000 on the host computer's active LAN IP.
# ==============================================================================

VITE_APP_MODE=local
VITE_API_BASE_URL=http://127.0.0.1:8000/api/
VITE_PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
VITE_BACKEND_PORT=8000
VITE_API_TARGET=http://127.0.0.1:8000

VITE_APP_NAME=Foodie (Local Dev)
VITE_ENVIRONMENT=development
